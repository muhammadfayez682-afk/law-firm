generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  system_admin // مسؤول النظام — صلاحيات كاملة + اعتماد الإغلاق
  supervisor // مشرف — مسؤول عن القضية، يحدد المسار
  lawyer // محامي — يترافع + يعتمد المذكرات
  researcher // باحث قانوني — يكتب المذكرات ويبحث
  secretary // سكرتارية
  accountant // محاسب
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  password            String
  phone               String?
  role                UserRole
  isActive            Boolean              @default(true)
  twoFaEnabled        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  responsibleCases    Case[]               @relation("ResponsibleLawyer")
  caseTeamMemberships CaseTeamMember[]
  accessOverrides     CaseAccessOverride[]
  uploadedDocuments   Document[]
  recordedMinutes     SessionMinutes[]
  createdTemplates    Template[]
  auditLogs           AuditLog[]
  filledTemplates     FilledTemplate[]
  closureRequests     CaseClosureRequest[] @relation("ClosureRequester")
  closureApprovals    CaseClosureRequest[] @relation("ClosureApprover")
  reopenActions       CaseReopenLog[]      @relation("ReopenedBy")
  recordedExpenses    Expense[]            @relation("RecordedExpenses")
  authoredMemos       LegalMemo[]          @relation("MemoAuthor")
  approvedMemos       LegalMemo[]          @relation("MemoApprover")
  memoReviews         MemoReview[]         @relation("MemoReviewer")
  receivedIntakes     IntakeRequest[]      @relation("IntakeReceiver")
  assessedIntakes     IntakeRequest[]      @relation("IntakeAssessor")
  decidedIntakes      IntakeRequest[]      @relation("IntakeDecider")
  delegatedAssessments IntakeRequest[]     @relation("IntakeAssessorDelegate")
  delegatedByMe       IntakeRequest[]      @relation("IntakeDelegator")
  intakeDocuments     IntakeDocument[]
  intakeNotes         IntakeNote[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  taskComments        TaskComment[]
  notifications           Notification[]           @relation("NotificationRecipient")
  triggeredNotifications  Notification[]           @relation("NotificationTrigger")
  notificationPreferences NotificationPreference[]
  entityChanges           EntityChangeLog[]
  taskAssignments         TaskAssignee[]
  assignedServices        LegalService[]           @relation("ServiceAssignee")
  createdServices         LegalService[]           @relation("ServiceCreator")
  serviceDocuments        ServiceDocument[]
  serviceNotes            ServiceNote[]
  completedPrepTasks      SessionPreparationTask[]

  @@map("users")
}

enum ClientType {
  individual
  company
}

enum ClientStatus {
  prospect
  active
  inactive
  archived
}

model Client {
  id                 String       @id @default(uuid())
  type               ClientType
  fullName           String
  nationalIdOrCr     String?      @unique
  nationality        String?
  representativeName String?
  phone              String?
  email              String?
  status             ClientStatus @default(prospect)
  createdAt          DateTime     @default(now())
  cases              Case[]
  agencies           Agency[]
  caseParties        CaseParty[]
  invoices           Invoice[]
  services           LegalService[]
  intakes            IntakeRequest[] @relation("IntakeExistingClient")

  // فهرس (غير فريد) لتسريع فحص تكرار الجوال. لا نجعله فريدًا لأن النظام
  // يسمح بتسجيل مكرر بعد تأكيد المستخدم (زر «متابعة الحفظ»). التفرّد على
  // nationalIdOrCr مضمون أصلًا عبر @unique أعلاه.
  @@index([phone])
  @@map("clients")
}

enum AgencyType {
  general
  special
}

model Agency {
  id           String     @id @default(uuid())
  client       Client     @relation(fields: [clientId], references: [id])
  clientId     String
  agencyNumber String
  agencyType   AgencyType
  scopeText    String
  issueDate    DateTime
  expiryDate   DateTime
  documentId   String?

  @@map("agencies")
}

enum CaseType {
  general
  commercial
  labor
  personal_status
  criminal
  administrative
  committee
  arbitration
  debt_collection
  other
}

enum CaseStatus {
  intake
  pending_agency // نشطة والفريق يعمل، لكن الوكالة لم تصدر بعد — لا جلسات محكمة
  amicable_settlement
  settled_amicably
  open
  in_progress
  on_hold
  ruled_first_instance
  appealed
  pending_closure
  closed
  archived
}

enum CasePriority {
  normal
  high
  urgent
}

enum CaseOutcome {
  won_full
  won_partial
  lost
  settled
  withdrawn
  dismissed
  client_terminated
}

model Case {
  id                     String                  @id @default(uuid())
  internalNumber         String                  @unique
  courtCaseNumber        String?
  displayNumber          String? // يُحدَّث تلقائيًا: courtCaseNumber ?? settlementNumber ?? internalNumber
  title                  String
  caseType               CaseType
  courtName              String?
  claimValue             Decimal?                @db.Decimal(14, 2)
  client                 Client                  @relation(fields: [clientId], references: [id])
  clientId               String
  status                 CaseStatus              @default(intake)
  outcome                CaseOutcome?
  openDate               DateTime                @default(now())
  closedDate             DateTime?
  responsibleLawyer      User                    @relation("ResponsibleLawyer", fields: [responsibleLawyerId], references: [id])
  responsibleLawyerId    String
  priority               CasePriority            @default(normal)
  conflictCheckConfirmed Boolean                 @default(false)
  clientPartyRole        PartyRole? // صفة موكّلنا في الدعوى (للاستعلام السريع)
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  parties                CaseParty[]
  team                   CaseTeamMember[]
  accessOverrides        CaseAccessOverride[]
  documents              Document[]
  sessions               Session[]
  invoices               Invoice[]
  expenses               Expense[]
  amicableSettlement     AmicableSettlement?
  filledTemplates        FilledTemplate[]
  closureRequest         CaseClosureRequest?
  reopenLogs             CaseReopenLog[]
  memos                  LegalMemo[]
  intakeRequest          IntakeRequest?           @relation("ActivatedCase")
  relatedIntakes         IntakeRequest[]          @relation("RelatedCase")
  tasks                  Task[]

  @@map("cases")
}

enum PartyRole {
  plaintiff // مدعي
  defendant // مدعى عليه
  appellant // مستأنف
  appellee // مستأنف ضده
  petitioner // مقدم الطلب (إداري)
  respondent // المدعى عليه (إداري/لجان)
  third_party // طرف ثالث
}

model CaseParty {
  id              String    @id @default(uuid())
  case            Case      @relation(fields: [caseId], references: [id])
  caseId          String
  role            PartyRole
  name            String
  identityNumber  String?
  phone           String?
  address         String?
  isOurClient     Boolean   @default(false) // ⚠️ الأهم: هل هذا الطرف موكّلنا؟
  opposingCounsel String? // محامي الطرف المقابل
  linkedClient    Client?   @relation(fields: [linkedClientId], references: [id])
  linkedClientId  String?
  notes           String?

  @@index([phone])
  @@index([identityNumber])
  @@map("case_parties")
}

enum CaseTeamRole {
  supervisor // المشرف — المسؤول الأول عن القضية
  lawyer // المحامي المترافع
  researcher // الباحث القانوني
}

model CaseTeamMember {
  id         String       @id @default(uuid())
  case       Case         @relation(fields: [caseId], references: [id])
  caseId     String
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  roleInCase CaseTeamRole
  assignedAt DateTime     @default(now())

  @@unique([caseId, userId])
  @@map("case_team_members")
}

enum AccessType {
  deny
  allow
}

model CaseAccessOverride {
  id         String     @id @default(uuid())
  case       Case       @relation(fields: [caseId], references: [id])
  caseId     String
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  accessType AccessType
  reason     String?

  @@unique([caseId, userId])
  @@map("case_access_overrides")
}

enum DocumentVisibility {
  case_team
  partners_only
  all_staff
}

model Document {
  id               String                   @id @default(uuid())
  case             Case?                    @relation(fields: [caseId], references: [id])
  caseId           String?
  uploadedBy       User                     @relation(fields: [uploadedById], references: [id])
  uploadedById     String
  fileName         String
  storagePath      String
  category         String?
  visibilityLevel  DocumentVisibility       @default(case_team)
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())

  @@map("documents")
}

enum TemplateCategory {
  contract
  judicial
  correspondence
  settlement
  internal_governance
}

model Template {
  id                  String           @id @default(uuid())
  name                String
  category            TemplateCategory
  applicableCaseTypes CaseType[]
  content             String
  placeholders        Json
  createdBy           User             @relation(fields: [createdById], references: [id])
  createdById         String
  updatedAt           DateTime         @updatedAt

  @@map("templates")
}

enum SessionType {
  negotiation_meeting
  hearing
  initial_listening
  verdict
  arbitration
}

enum SessionStatus {
  scheduled
  held
  postponed
}

enum SessionMode {
  in_person
  remote
  hybrid
}

enum SessionPlatform {
  zoom
  google_meet
  microsoft_teams
  najiz
  qiwa
  taradhi
  other
}

model Session {
  id             String          @id @default(uuid())
  case           Case            @relation(fields: [caseId], references: [id])
  caseId         String
  sessionType    SessionType
  sessionDate    DateTime
  hijriDate      String?
  court          String?
  reminderBefore Int?
  status         SessionStatus   @default(scheduled)
  // نمط الجلسة + رابط الاجتماع عن بُعد (إلزامي عند remote/hybrid)
  sessionMode     SessionMode      @default(in_person)
  meetingLink     String?
  meetingPlatform SessionPlatform?
  meetingPassword String?
  // قائمة مهام تحضير الجلسة (تُولَّد تلقائيًا قبل الجلسة بأسبوع)
  prepChecklistGenerated Boolean                  @default(false)
  preparationChecklist   SessionPreparationTask[]
  minutes        SessionMinutes?
  filledTemplates FilledTemplate[]

  @@map("sessions")
}

enum PrepTaskType {
  team_meeting
  client_contact
  najiz_review
  agency_verification
  memos_review
  documents_review
  external_review
  strategy_alignment
  other
}

model SessionPreparationTask {
  id            String       @id @default(uuid())
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  taskType      PrepTaskType
  title         String
  description   String       @db.Text
  isRequired    Boolean      @default(true)
  isCompleted   Boolean      @default(false)
  completedBy   User?        @relation(fields: [completedById], references: [id])
  completedById String?
  completedAt   DateTime?
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())

  @@index([sessionId])
  @@map("session_preparation_tasks")
}

model SessionMinutes {
  id           String   @id @default(uuid())
  session      Session  @relation(fields: [sessionId], references: [id])
  sessionId    String   @unique
  content      String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime @default(now())

  @@map("session_minutes")
}

enum InvoiceStatus {
  due
  paid
  overdue
}

model Invoice {
  id        String        @id @default(uuid())
  client    Client        @relation(fields: [clientId], references: [id])
  clientId  String
  case      Case?         @relation(fields: [caseId], references: [id])
  caseId    String?
  amount    Decimal       @db.Decimal(12, 2)
  vatAmount Decimal       @default(0) @db.Decimal(12, 2)
  status    InvoiceStatus @default(due)
  issueDate DateTime      @default(now())
  dueDate   DateTime?

  @@map("invoices")
}

model Expense {
  id           String   @id @default(uuid())
  case         Case     @relation(fields: [caseId], references: [id])
  caseId       String
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  expenseDate  DateTime @default(now())
  recordedBy   User?    @relation("RecordedExpenses", fields: [recordedById], references: [id])
  recordedById String?

  @@map("expenses")
}

enum SettlementPlatform {
  qiwa
  taradhi
}

enum SettlementOutcome {
  pending
  settled
  failed
}

model AmicableSettlement {
  id                   String             @id @default(uuid())
  case                 Case               @relation(fields: [caseId], references: [id])
  caseId               String             @unique
  platform             SettlementPlatform
  isMandatory          Boolean            @default(false)
  requestNumber        String?
  firstSessionDate     DateTime?
  deadlineDate         DateTime?
  mediatorName         String?
  outcome              SettlementOutcome  @default(pending)
  settlementDocumentId String?
  failureDocumentId    String?
  createdAt            DateTime           @default(now())

  @@map("amicable_settlements")
}

enum AuditAction {
  view
  create
  update
  delete
}

model AuditLog {
  id           String      @id @default(uuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  action       AuditAction
  resourceType String
  resourceId   String
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([resourceType, resourceId])
  @@map("audit_log")
}

model FilledTemplate {
  id          String   @id @default(uuid())
  templateKey String
  caseId      String?
  intakeId    String?
  sessionId   String?
  filledBy    String
  data        Json
  pdfPath     String?
  createdAt   DateTime @default(now())

  case    Case?          @relation(fields: [caseId], references: [id])
  intake  IntakeRequest? @relation(fields: [intakeId], references: [id])
  session Session?       @relation(fields: [sessionId], references: [id])
  user    User           @relation(fields: [filledBy], references: [id])

  @@index([templateKey])
  @@index([caseId])
  @@index([intakeId])
  @@map("filled_templates")
}

enum ClosureReason {
  final_judgment
  settlement
  withdrawal
  agency_revoked
  statute_barred
  other
}

enum ClosureStatus {
  pending_approval
  approved
  rejected
}

model CaseClosureRequest {
  id            String        @id @default(uuid())
  case          Case          @relation(fields: [caseId], references: [id])
  caseId        String        @unique
  outcome       CaseOutcome
  closureReason ClosureReason
  closureNotes  String
  requestedBy   User          @relation("ClosureRequester", fields: [requestedById], references: [id])
  requestedById String
  requestedAt   DateTime      @default(now())
  status        ClosureStatus @default(pending_approval)
  approvedBy    User?         @relation("ClosureApprover", fields: [approvedById], references: [id])
  approvedById  String?
  approvedAt    DateTime?
  rejectionNote String?

  @@map("case_closure_requests")
}

model CaseReopenLog {
  id           String   @id @default(uuid())
  case         Case     @relation(fields: [caseId], references: [id])
  caseId       String
  reopenedBy   User     @relation("ReopenedBy", fields: [reopenedById], references: [id])
  reopenedById String
  reason       String
  reopenedAt   DateTime @default(now())

  @@map("case_reopen_logs")
}

model CaseFlowStage {
  id          String   @id @default(uuid())
  caseType    CaseType
  order       Int
  key         String
  labelAr     String
  isMandatory Boolean  @default(false)
  authority   String?
  platformUrl String?
  active      Boolean  @default(true)

  @@unique([caseType, order])
  @@map("case_flow_stages")
}

enum MemoStatus {
  draft // مسودة — الباحث يكتب
  submitted // مُرسلة للمحامي للمراجعة
  changes_requested // المحامي طلب تعديلات
  approved // معتمدة — جاهزة للتقديم
  submitted_to_court // قُدّمت للمحكمة
}

model LegalMemo {
  id      String @id @default(uuid())
  case    Case   @relation(fields: [caseId], references: [id])
  caseId  String

  title    String // عنوان المذكرة
  memoType String // مذكرة دفاع / رد / تعقيب / استئناف
  content  String @db.Text // نص المذكرة

  // البحث القانوني المرفق
  legalBasis String? @db.Text // الأنظمة واللوائح المستند إليها
  precedents String? @db.Text // السوابق القضائية
  circulars  String? @db.Text // التعاميم ذات الصلة

  status  MemoStatus @default(draft)
  version Int        @default(1)

  // من كتبها (باحث)
  authoredBy   User   @relation("MemoAuthor", fields: [authoredById], references: [id])
  authoredById String

  // من اعتمدها (محامي)
  approvedBy   User?     @relation("MemoApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews MemoReview[]

  // النسخ التكميلية: المذكرات المعتمدة/المُقدّمة لا تُعدّل — تُصدَر نسخة تكميلية جديدة تشير للأصل.
  parentMemoId String?
  parent       LegalMemo?  @relation("MemoVersions", fields: [parentMemoId], references: [id])
  supplements  LegalMemo[] @relation("MemoVersions")

  @@map("legal_memos")
}

// سجل مراجعات المحامي
model MemoReview {
  id           String    @id @default(uuid())
  memo         LegalMemo @relation(fields: [memoId], references: [id])
  memoId       String
  reviewedBy   User      @relation("MemoReviewer", fields: [reviewedById], references: [id])
  reviewedById String
  action       String // "approved" | "changes_requested"
  comments     String    @db.Text // ملاحظات المحامي
  reviewedAt   DateTime  @default(now())

  @@map("memo_reviews")
}

enum IntakeStatus {
  received // تم الاستقبال
  conflict_check // فحص تعارض المصالح
  under_assessment // قيد التقييم
  fee_agreement_pending // بانتظار توقيع عقد الأتعاب
  accepted // مقبولة → تحولت لقضية
  rejected // مرفوضة
  cancelled // العميل انسحب
}

enum IntakeSource {
  referral_client // إحالة من عميل
  referral_lawyer // إحالة من محامٍ آخر
  website // الموقع الإلكتروني
  advertisement // إعلان
  personal_network // علاقات شخصية
  walk_in // حضور مباشر
  other
}

enum ConflictCheckResult {
  pending // لم يُفحص بعد
  clear // لا يوجد تعارض
  potential // تعارض محتمل
  confirmed // تعارض مؤكد
}

enum IntakeKind {
  case // ينتهي بإنشاء قضية
  service // ينتهي بإنشاء خدمة قانونية
}

enum RejectionReason {
  conflict_of_interest // تعارض مصالح
  outside_expertise // خارج التخصص
  weak_legal_position // ضعف الموقف القانوني
  fee_disagreement // خلاف على الأتعاب
  client_withdrew // انسحاب العميل
  capacity // عدم توفر طاقة
  other
}

model IntakeRequest {
  id            String @id @default(uuid())
  requestNumber String @unique // ترقيم: INT-2026-0001

  // بيانات العميل الأولية (قد لا يكون عميلاً بعد)
  clientName     String
  clientPhone    String
  clientEmail    String?
  clientIdNumber String? // هوية/سجل

  // نوع الطلب: قضية أو خدمة قانونية + ربط اختياري بعميل/قضية موجودة
  requestKind         IntakeKind   @default(case)
  existingClient      Client?      @relation("IntakeExistingClient", fields: [existingClientId], references: [id])
  existingClientId    String?
  relatedCase         Case?        @relation("RelatedCase", fields: [relatedCaseId], references: [id])
  relatedCaseId       String?
  proposedServiceType ServiceType? // نوع الخدمة المقترح (عند requestKind = service)

  // بيانات النزاع الأولية
  disputeSummary String    @db.Text // وصف موجز للنزاع
  opposingParty  String? // الطرف المقابل (لفحص التعارض)
  proposedType   CaseType? // نوع القضية المقترح

  // مصدر القضية
  source     IntakeSource
  referredBy String? // من أحال العميل

  // المستلم والحالة
  receivedBy   User         @relation("IntakeReceiver", fields: [receivedById], references: [id])
  receivedById String
  receivedAt   DateTime     @default(now())
  status       IntakeStatus @default(received)

  // فحص تعارض المصالح
  conflictResult    ConflictCheckResult @default(pending)
  conflictNotes     String?             @db.Text
  conflictCheckedAt DateTime?

  // دراسة التقييم (من مسؤول النظام)
  assessmentBy      User?     @relation("IntakeAssessor", fields: [assessmentById], references: [id])
  assessmentById    String?
  // تفويض التقييم لمستخدم آخر (يعمل التقييم، والقرار يبقى لمسؤول النظام/المشرف)
  assessmentDelegatedTo   User?     @relation("IntakeAssessorDelegate", fields: [assessmentDelegatedToId], references: [id])
  assessmentDelegatedToId String?
  assessmentDelegatedBy   User?     @relation("IntakeDelegator", fields: [assessmentDelegatedById], references: [id])
  assessmentDelegatedById String?
  assessmentDelegatedAt   DateTime?
  legalBasis        String?   @db.Text // التكييف القانوني
  strengths         String?   @db.Text // نقاط القوة
  weaknesses        String?   @db.Text // نقاط الضعف
  jurisdiction      String? // الاختصاص القضائي
  estimatedDuration String? // المدة التقريبية
  proposedFee       Decimal?  @db.Decimal(12, 2) // الأتعاب المقترحة
  assessedAt        DateTime?

  // قرار القبول/الرفض
  decision        String? // "accepted" | "rejected"
  decisionBy      User?            @relation("IntakeDecider", fields: [decisionById], references: [id])
  decisionById    String?
  decisionAt      DateTime?
  rejectionReason RejectionReason?
  rejectionNotes  String?          @db.Text

  // عقد الأتعاب
  feeAgreementSignedAt   DateTime?
  feeAgreementDocId      String?
  advancePaymentReceived Boolean   @default(false)

  // توقّع إصدار الوكالة (عند التفعيل بدون وكالة) — لتذكير أدق بالمتابعة.
  agencyExpectedDate DateTime?

  // ربط بالقضية عند القبول (القضية المُنشأة من هذا الطلب)
  case   Case?   @relation("ActivatedCase", fields: [caseId], references: [id])
  caseId String? @unique // القضية المُنشأة

  documents       IntakeDocument[]
  notes           IntakeNote[]
  filledTemplates FilledTemplate[]
  tasks           Task[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([clientPhone])
  @@map("intake_requests")
}

model IntakeDocument {
  id           String        @id @default(uuid())
  intake       IntakeRequest @relation(fields: [intakeId], references: [id])
  intakeId     String
  title        String
  storagePath  String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime      @default(now())

  @@map("intake_documents")
}

model IntakeNote {
  id        String        @id @default(uuid())
  intake    IntakeRequest @relation(fields: [intakeId], references: [id])
  intakeId  String
  content   String        @db.Text
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime      @default(now())

  @@map("intake_notes")
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
  overdue // محسوبة تلقائيًا عند العرض (استحقاق فائت ولم تُنجَز)
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum TaskCategory {
  case_related // مرتبطة بقضية
  administrative // إدارية
  research // بحث
  document_preparation // إعداد مستندات
  meeting // اجتماع
  follow_up // متابعة
  personal // شخصية
  other
}

model Task {
  id          String       @id @default(uuid())
  taskNumber  String       @unique // ترقيم: TSK-2026-0001
  title       String
  description String?      @db.Text
  category    TaskCategory

  // الإسناد: assignedTo = المُسند الرئيسي (للتوافق)؛ assignees = كل المُسندين (تعدّد).
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToId String
  assignedBy   User   @relation("TaskCreator", fields: [assignedById], references: [id])
  assignedById String
  assignees    TaskAssignee[]

  // ربط اختياري بقضية أو خدمة أو طلب استلام (أحدها فقط)
  case      Case?          @relation(fields: [caseId], references: [id])
  caseId    String?
  service   LegalService?  @relation(fields: [serviceId], references: [id])
  serviceId String?
  intake    IntakeRequest? @relation(fields: [intakeId], references: [id])
  intakeId  String?

  // التوقيت
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  status   TaskStatus   @default(pending)
  priority TaskPriority @default(normal)

  // نتيجة الإنجاز
  completionNote String? @db.Text

  // إلغاء ناعم — لا يُحذف السجل فعليًا
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]

  @@index([assignedToId, status])
  @@index([caseId])
  @@index([serviceId])
  @@index([intakeId])
  @@map("tasks")
}

enum TaskAssigneeStatus {
  pending
  in_progress
  completed
  declined
}

// مُسند فردي ضمن مهمة متعددة المُسندين — كل مُسند يدير حالته الخاصة.
model TaskAssignee {
  id             String             @id @default(uuid())
  task           Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  user           User               @relation(fields: [userId], references: [id])
  userId         String
  status         TaskAssigneeStatus @default(pending)
  completedAt    DateTime?
  completionNote String?            @db.Text
  createdAt      DateTime           @default(now())

  @@unique([taskId, userId])
  @@index([userId, status])
  @@map("task_assignees")
}

model TaskComment {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("task_comments")
}

enum NotificationType {
  // الاستلام
  intake_new
  intake_conflict_detected
  intake_pending_assessment
  intake_assessment_delegated // للمُفوَّض
  intake_pending_decision
  intake_accepted
  intake_rejected

  // المذكرات
  memo_assigned
  memo_pending_review
  memo_changes_requested
  memo_approved
  memo_submitted_to_court

  // القضايا
  case_assigned
  case_closure_requested
  case_closure_approved
  case_closure_rejected
  case_reopened
  case_number_added // أُضيف رقم المحكمة

  // الجلسات
  session_scheduled
  session_reminder_day
  session_reminder_hour
  session_cancelled
  session_postponed
  session_prep_reminder // تحضير الجلسة قبل 3 أيام
  session_prep_urgent // تحضير الجلسة قبل 24 ساعة
  session_prep_critical // عنصر حرج غير جاهز (وكالة/مذكرة)

  // الوكالات
  agency_expiring_soon
  agency_expiring_urgent
  agency_expired
  agency_pending_reminder // مرّت 3 أيام على التفعيل بلا وكالة
  agency_pending_urgent // مرّ أسبوع بلا وكالة
  agency_delayed // مرّ أسبوعان بلا وكالة
  agency_issued // صدرت الوكالة والقضية صارت نشطة كاملة

  // التسوية
  settlement_deadline_soon
  settlement_deadline_urgent
  settlement_settled
  settlement_failed

  // المهام
  task_assigned
  task_due_soon
  task_overdue
  task_completed
  task_comment_added

  // الفواتير
  invoice_overdue

  // عام
  mention
  system_announcement
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum NotificationChannel {
  in_app
  email
  sms
  whatsapp
}

model Notification {
  id            String                @id @default(uuid())
  recipient     User                  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  recipientId   String
  type          NotificationType
  priority      NotificationPriority  @default(normal)
  title         String
  message       String                @db.Text
  actionUrl     String?
  actionLabel   String?
  resourceType  String?
  resourceId    String?
  isRead        Boolean               @default(false)
  readAt        DateTime?
  channels      NotificationChannel[] @default([in_app])
  deliveryLog   Json?
  triggeredBy   User?                 @relation("NotificationTrigger", fields: [triggeredById], references: [id])
  triggeredById String?
  createdAt     DateTime              @default(now())
  expiresAt     DateTime?

  @@index([recipientId, isRead, createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

model NotificationPreference {
  id       String                @id @default(uuid())
  user     User                  @relation(fields: [userId], references: [id])
  userId   String
  type     NotificationType
  channels NotificationChannel[]

  @@unique([userId, type])
  @@map("notification_preferences")
}

enum ChangeReason {
  data_entry_error // خطأ إدخال
  official_update // تحديث رسمي (من المحكمة، ناجز...)
  client_information_change // العميل غيّر بياناته
  legal_correction // تصحيح قانوني
  system_migration // نقل بيانات
  other // أخرى
}

// سجل تعديلات موحّد لكل الكيانات — يوثّق كل تغيير حقل مع سببه وشرحه الإلزامي.
model EntityChangeLog {
  id         String @id @default(uuid())
  entityType String // "case" | "client" | "agency" | "party" | "intake" | "memo"
  entityId   String

  fieldName  String // اسم الحقل المُعدَّل
  fieldLabel String // اسمه بالعربي للعرض

  oldValue String? @db.Text // القيمة السابقة (JSON إذا معقّد)
  newValue String? @db.Text // القيمة الجديدة

  changedBy    User         @relation(fields: [changedById], references: [id])
  changedById  String
  changeReason ChangeReason
  reasonNote   String       @db.Text // شرح إلزامي (30 حرفًا على الأقل)

  changedAt DateTime @default(now())
  ipAddress String?

  batchId String? // يجمع الحقول المُعدَّلة في عملية واحدة

  @@index([entityType, entityId, changedAt])
  @@index([changedById, changedAt])
  @@map("entity_change_log")
}

// ===== الخدمات القانونية (وحدة مستقلة عن القضايا: لا محكمة/جلسات/خصومة) =====
enum ServiceType {
  legal_consultation // استشارة قانونية
  company_formation // تأسيس شركة
  documentation // توثيق
  execution_request // طلبات التنفيذ
  contract_drafting // صياغة عقود
  other
}

enum ServiceStatus {
  new
  in_progress
  pending_client
  under_review
  completed
  cancelled
}

enum ServicePriority {
  normal
  high
  urgent
}

model LegalService {
  id            String          @id @default(uuid())
  serviceNumber String          @unique // SRV-2026-0001
  title         String
  serviceType   ServiceType
  description   String          @db.Text

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  status   ServiceStatus   @default(new)
  priority ServicePriority @default(normal)

  assignedTo   User   @relation("ServiceAssignee", fields: [assignedToId], references: [id])
  assignedToId String

  requestedAt DateTime  @default(now())
  dueDate     DateTime?
  completedAt DateTime?

  deliverable      String?  @db.Text // نص المخرج
  deliverableNotes String?  @db.Text
  fee              Decimal? @db.Decimal(12, 2)

  createdBy   User     @relation("ServiceCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents ServiceDocument[]
  notes     ServiceNote[]
  tasks     Task[]

  @@index([assignedToId, status])
  @@index([clientId])
  @@map("legal_services")
}

model ServiceDocument {
  id           String       @id @default(uuid())
  service      LegalService @relation(fields: [serviceId], references: [id])
  serviceId    String
  title        String
  storagePath  String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime     @default(now())

  @@map("service_documents")
}

model ServiceNote {
  id        String       @id @default(uuid())
  service   LegalService @relation(fields: [serviceId], references: [id])
  serviceId String
  content   String       @db.Text
  author    User         @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime     @default(now())

  @@map("service_notes")
}
