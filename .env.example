# قاعدة البيانات
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lawfirm"

# NextAuth
NEXTAUTH_SECRET="change_me_in_production"
NEXTAUTH_URL="http://localhost:3000"

# البريد (نظام الإشعارات — سيُفعّل لاحقًا)
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@qudum.sa
RESEND_API_KEY=

# Cron (فحص الإشعارات المرتبطة بالوقت — GET /api/cron/notifications بترويسة x-cron-secret)
CRON_SECRET=change_me_in_production
