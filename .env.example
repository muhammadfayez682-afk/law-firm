# ==== متغيرات البيئة ====
# محليًا: انسخ هذا الملف إلى .env واملأ القيم.
# على Railway: اضبط هذه المتغيرات في تبويب Variables للخدمة (لا تُرفع في Git).

# قاعدة البيانات
# محليًا: postgres محلي. على Railway: أضِف إضافة PostgreSQL ثم اربط ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lawfirm"

# NextAuth
# NEXTAUTH_SECRET: ولّد قيمة عشوائية للإنتاج → openssl rand -base64 32
# NEXTAUTH_URL: عنوان النطاق العام للخدمة (على Railway: https://<اسم-الخدمة>.up.railway.app)
NEXTAUTH_SECRET="change_me_in_production"
NEXTAUTH_URL="http://localhost:3000"

# البريد (نظام الإشعارات — سيُفعّل لاحقًا)
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@qudum.sa
RESEND_API_KEY=

# Cron (فحص الإشعارات المرتبطة بالوقت — GET /api/cron/notifications بترويسة x-cron-secret)
# ولّد قيمة عشوائية للإنتاج، واستخدمها في جدولة Railway Cron.
CRON_SECRET=change_me_in_production
